<?xml version="1.0" ?>
<robot name="wheel_drive">

  <link name="mount" />

  <joint name="motor_joint" type="continuous">
    <parent link="mount" />
    <child link="wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00014" iyz="0" izz="0.00025" />
    </inertial>
  </link>

</robot>
