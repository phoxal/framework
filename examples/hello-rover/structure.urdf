<?xml version="1.0" ?>
<robot name="HelloRover">

  <!-- A phantom link located at ground level. -->
  <link name="base_footprint" />

  <!-- Main chassis frame. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.30 0.20 0.08" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.30 0.20 0.08" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <link name="left_wheel_mount" />

  <joint name="left_wheel_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_wheel_mount" />
    <origin xyz="0 0.15 -0.05" rpy="-1.5708 0 0" />
  </joint>

  <link name="right_wheel_mount" />

  <joint name="right_wheel_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_wheel_mount" />
    <origin xyz="0 -0.15 -0.05" rpy="1.5708 0 0" />
  </joint>

</robot>
