{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "description": "Exact top-level `robot.yaml` v0 document.",
  "type": "object",
  "properties": {
    "behavior": {
      "description": "Authoritative behavior root selected for this robot. Behavior\ndefinitions themselves live under `behaviors/` in the robot root.",
      "anyOf": [
        {
          "$ref": "#/$defs/BehaviorConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "extends": {
      "description": "Ordered parent robot documents composed before this leaf manifest.\n\nParent maps are deep-merged in declaration order, then the leaf wins.\nSequence and scalar values replace earlier values.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "robot": {
      "$ref": "#/$defs/RobotSection"
    },
    "router": {
      "description": "Optional project-relative Zenoh router configuration.",
      "$ref": "#/$defs/Router"
    },
    "schema": {
      "$ref": "#/$defs/Schema"
    },
    "services": {
      "description": "The user services this robot runs, keyed by service identity, each with\nits user-owned configuration. The Cargo workspace is the candidate set\n(a declared service must have a matching workspace crate); this map\nselects which discovered services belong to the robot and are built,\nstaged, and launched. An undeclared workspace service crate is legal\nand simply not part of the robot.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/UserService"
      }
    },
    "tools": {
      "description": "The additional user tools this robot runs, keyed by tool identity, each\nwith its user-owned configuration - symmetric with `services`. Official\ntools stay CLI-catalog-owned, always run, and take no configuration\nhere; a `tools/` workspace crate overriding an official identity is a\nsource override, not a declaration, and is never listed here.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/UserTool"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "robot"
  ],
  "$defs": {
    "BehaviorConfig": {
      "type": "object",
      "properties": {
        "autostart": {
          "type": "boolean",
          "default": false
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "root"
      ]
    },
    "Component": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "driver": {
          "anyOf": [
            {
              "$ref": "#/$defs/DriverConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "mount_link": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Parameters"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Role"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "component",
        "mount_link"
      ]
    },
    "ConnectionConfig": {
      "description": "Connection configuration for executable drivers.",
      "oneOf": [
        {
          "description": "CAN bus connection.",
          "type": "object",
          "properties": {
            "bus": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "node_id": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "can"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "bus",
            "node_id"
          ]
        },
        {
          "description": "I2C connection.",
          "type": "object",
          "properties": {
            "address": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "bus": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "i2c"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "bus",
            "address"
          ]
        },
        {
          "description": "SPI connection.",
          "type": "object",
          "properties": {
            "bus": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "chip_select": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "spi"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "bus",
            "chip_select"
          ]
        },
        {
          "description": "Serial port connection (RS-232/RS-485).",
          "type": "object",
          "properties": {
            "baud": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "port": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "serial"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "port",
            "baud"
          ]
        },
        {
          "description": "UART connection (distinct from Serial for hardware-specific drivers).",
          "type": "object",
          "properties": {
            "baud_rate": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "port": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "uart"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "port",
            "baud_rate"
          ]
        },
        {
          "description": "USB connection.",
          "type": "object",
          "properties": {
            "product_id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "usb"
            },
            "vendor_id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "GPIO pins.",
          "type": "object",
          "properties": {
            "chip": {
              "type": "string"
            },
            "pins": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GpioPinConfig"
              }
            },
            "type": {
              "type": "string",
              "const": "gpio"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "chip",
            "pins"
          ]
        }
      ]
    },
    "DriverConfig": {
      "type": "object",
      "properties": {
        "connection": {
          "$ref": "#/$defs/ConnectionConfig"
        },
        "runtime_clock_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 100,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "connection"
      ]
    },
    "GpioDirection": {
      "type": "string",
      "enum": [
        "input",
        "output"
      ]
    },
    "GpioPinConfig": {
      "type": "object",
      "properties": {
        "active_low": {
          "type": "boolean",
          "default": false
        },
        "direction": {
          "$ref": "#/$defs/GpioDirection"
        },
        "line": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "line",
        "direction"
      ]
    },
    "KinematicConfig": {
      "description": "The robot's kinematic model - a direct field of `robot:` (was\n`motion.kinematic`; the `motion:` wrapper is gone).\n\nEvery `CapabilityRef` field carries a test-only\n`#[schemars(with = \"String\")]` override: `CapabilityRef` lives in\n`crate::model::component` (out of this module's schema-derive scope)\nand serializes as a plain `\"<component>.<capability>\"` string\n(`#[serde(try_from = \"String\", into = \"String\")]`), so treating it as\n`String` in the generated JSON Schema is exact, not an approximation.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "differential"
            },
            "left_actuators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "left_encoders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "right_actuators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "right_encoders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "wheel_base_m": {
              "type": "number",
              "format": "double"
            },
            "wheel_radius_m": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "left_actuators",
            "right_actuators",
            "left_encoders",
            "right_encoders",
            "wheel_radius_m",
            "wheel_base_m"
          ]
        },
        {
          "type": "object",
          "properties": {
            "front_left_actuator": {
              "type": "string"
            },
            "front_right_actuator": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "mecanum"
            },
            "rear_left_actuator": {
              "type": "string"
            },
            "rear_right_actuator": {
              "type": "string"
            },
            "track_m": {
              "type": "number",
              "format": "double"
            },
            "wheel_base_m": {
              "type": "number",
              "format": "double"
            },
            "wheel_radius_m": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "front_left_actuator",
            "front_right_actuator",
            "rear_left_actuator",
            "rear_right_actuator",
            "wheel_radius_m",
            "wheel_base_m",
            "track_m"
          ]
        },
        {
          "type": "object",
          "properties": {
            "drive_actuator": {
              "type": "string"
            },
            "drive_encoder": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "ackermann"
            },
            "max_steering_angle_rad": {
              "type": "number",
              "format": "double"
            },
            "steering_actuator": {
              "type": "string"
            },
            "steering_encoder": {
              "type": [
                "string",
                "null"
              ]
            },
            "track_m": {
              "type": "number",
              "format": "double"
            },
            "wheel_base_m": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "steering_actuator",
            "drive_actuator",
            "wheel_base_m",
            "track_m",
            "max_steering_angle_rad"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actuators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "encoders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "omnidirectional"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "actuators",
            "encoders"
          ]
        }
      ]
    },
    "MotionLimits": {
      "description": "Robot-wide planar motion limits enforced independently by `motion` and\n`drive`. These are authored facts, not per-runtime configuration.",
      "type": "object",
      "properties": {
        "max_angular_speed_radps": {
          "type": "number",
          "format": "double"
        },
        "max_linear_speed_mps": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_linear_speed_mps",
        "max_angular_speed_radps"
      ]
    },
    "Parameters": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "direction_sign": {
              "type": "integer",
              "format": "int8",
              "default": 1,
              "maximum": 127,
              "minimum": -128
            },
            "kind": {
              "type": "string",
              "const": "motor"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "direction_sign": {
              "type": "integer",
              "format": "int8",
              "default": 1,
              "maximum": 127,
              "minimum": -128
            },
            "kind": {
              "type": "string",
              "const": "encoder"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "accelerometer"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gyroscope"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "magnetometer"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "imu"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gnss"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "camera"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "depth"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "lidar"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mmwave"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "microphone"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "speaker"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "battery"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "led"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "emergency_stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "RobotSection": {
      "description": "`robot:` - the robot model: identity, structure, kinematic, and\ncomponents.",
      "type": "object",
      "properties": {
        "components": {
          "description": "Component instance map: instance-id -> instance.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Component"
          }
        },
        "id": {
          "description": "The robot id (was `identity.id`).",
          "type": "string"
        },
        "kinematic": {
          "description": "The kinematic model (was `motion.kinematic`; the `motion:` wrapper is\ngone - `kinematic` is a direct field of `robot:`).",
          "$ref": "#/$defs/KinematicConfig"
        },
        "motion_limits": {
          "description": "Manifest-wide planar speed limits. Both `motion` and `drive` enforce these\nindependently so an arbitration defect cannot bypass the actuator\nbackstop.",
          "$ref": "#/$defs/MotionLimits"
        },
        "namespace": {
          "description": "The bus namespace (was `identity.namespace`).",
          "type": "string"
        },
        "structure": {
          "description": "Path to the URDF structure file, relative to the robot root.",
          "type": "string",
          "default": "structure.urdf"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "kinematic",
        "motion_limits"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "localization",
        "mapping",
        "traversability",
        "odometry",
        "perception"
      ]
    },
    "Router": {
      "type": "object",
      "properties": {
        "config": {
          "description": "Zenoh JSON5 configuration path relative to the resolved robot root.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Schema": {
      "type": "string",
      "enum": [
        "robot/v0"
      ]
    },
    "UserService": {
      "description": "One declared user service: presence in `services` is the declaration;\n`config` is its user-owned configuration.",
      "type": "object",
      "properties": {
        "config": true
      },
      "additionalProperties": false
    },
    "UserTool": {
      "description": "One declared additional user tool: presence in `tools` is the declaration;\n`config` is its user-owned configuration. Same shape as [`UserService`],\nkept distinct so the two declarations stay independently documented types.",
      "type": "object",
      "properties": {
        "config": true
      },
      "additionalProperties": false
    }
  }
}
