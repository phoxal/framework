<mujoco model="example-moving-rover-scene">
  <compiler angle="radian" />
  <option
    timestep="0.01"
    gravity="0 0 -9.81"
    integrator="implicitfast"
    solver="Newton"
  />
  <!-- Synthetic origin for this sandbox scene, not a physical deployment. -->
  <custom>
    <numeric name="phoxal_georeference" data="0 0 0 0 0 0 0" />
    <text name="phoxal_georeference_axes" data="ENU" />
    <text name="phoxal_georeference_datum" data="WGS84_ELLIPSOIDAL" />
  </custom>
  <statistic center="0 0 0.25" extent="1.4" />
  <visual><global offwidth="1280" offheight="960" /></visual>
  <worldbody>
    <site name="robot_mount" pos="0 0 0" size="0.002" />
    <geom
      name="ground"
      type="plane"
      size="20 20 0.1"
      friction="1 0.5 0.5"
    />
  </worldbody>
</mujoco>
