#!/usr/bin/env bash
# Mock `cargo-phoxal publish <kind> <name> --path <dir>` for the
# release-groups contract test. Behavior is driven by $SCENARIO:
#   state/<name>.sha   required checksum to report
#   state/<name>.ver   version being published
#   state/fail-after   fail once more than this many calls happened
# On success the submission is recorded in state/submitted; the merge
# mock deploys it into the scenario's local registry.
set -euo pipefail

name="$3"
root="$SCENARIO"
fail_after="$(cat "$root/state/fail-after" 2>/dev/null || echo 0)"
count_file="$root/state/count"
count=$(( $(cat "$count_file" 2>/dev/null || echo 0) + 1 ))
echo "$count" > "$count_file"
if [ "$fail_after" -gt 0 ] && [ "$count" -gt "$fail_after" ]; then
    echo "mock publication failure for $name" >&2
    exit 1
fi

sha="$(cat "$root/state/$name.sha")"
number="$(( $(cat "$root/state/pr-counter" 2>/dev/null || echo 0) + 1 ))"
echo "$number" > "$root/state/pr-counter"
echo "$name $sha pull/$number" >> "$root/state/submitted"
echo "archive: $root/state/$name.crate"
echo "sha256: $sha"
echo "publication: pending-review"
echo "pull-request: https://github.com/phoxal/registry/pull/$number"
